{
  "name": "dsh-web-login",
  "version": "1.0.0",
  "private": true,
  "description": "账号密码登录 DSH Web 界面：用全局唯一账号替代启动 token 链接，并可在设置中修改账号或密码。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "login",
    "password"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
